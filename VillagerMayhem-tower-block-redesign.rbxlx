local Config=require(game:GetService("ReplicatedStorage").Modules.RewardConfig);local Profiles=require(script.Parent.PlayerProfileService);local Service={};local settled:{[string]:boolean}={}
local function grant(p:Player,amount:number):number local profile=Profiles.GetProfile(p);if profile and profile.Monetization.OwnedGamePasses.VIPVillagerPass then amount=math.floor(amount*1.1+.5)end;Profiles.IncrementValue(p,"Economy.Coins",amount);Profiles.IncrementValue(p,"Economy.LifetimeCoins",amount);return amount end
function Service.Race(p:Player,matchId:string,mode:string,place:number,finished:boolean):number if settled[matchId..":"..p.UserId] then return 0 end;settled[matchId..":"..p.UserId]=true;local tableFor=mode=="RankedRace" and Config.RankedRace or Config.CasualRace;local amount=if finished then (tableFor[math.min(place,#tableFor)] or tableFor[#tableFor]) else (mode=="RankedRace" and Config.RankedDNF or Config.CasualDNF);if mode=="CasualRace" and finished then amount+=Config.CasualMapBonus end;return grant(p,amount) end
function Service.Tower(p:Player,runId:string,first:boolean,personalBest:boolean):number if settled[runId] then return 0 end;settled[runId]=true;local amount=first and Config.TowerFirst or Config.TowerRepeat;if personalBest then amount+=Config.TowerPersonalBest end;return grant(p,amount) end
function Service.ClaimDaily(p:Player):(boolean,number) local profile=Profiles.GetProfile(p);if not profile then return false,0 end;local today=math.floor(os.time()/86400);local last=math.floor(profile.DailyRewards.LastClaimTimestamp/86400);if last==today then return false,0 end;if last==today-1 then profile.DailyRewards.CurrentStreak=(profile.DailyRewards.CurrentStreak%7)+1 else profile.DailyRewards.CurrentStreak=1 end;local amount=Config.Daily[profile.DailyRewards.CurrentStreak];profile.DailyRewards.LastClaimTimestamp=os.time();profile.DailyRewards.TotalClaims+=1;Profiles.MarkDirty(p);return true,grant(p,amount) end
return Service
]]></string>
