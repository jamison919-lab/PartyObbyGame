      </Item>
      <Item class="LocalScript" referent="107">
        <Properties>
          <string name="Name">LobbyUI</string>
          <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players");local GuiService=game:GetService("GuiService");local ReplicatedStorage=game:GetService("ReplicatedStorage");local player=Players.LocalPlayer;local gui=Instance.new("ScreenGui");gui.Name="LobbyGui";gui.ResetOnSpawn=false;gui.IgnoreGuiInset=false;gui.Parent=player.PlayerGui
local large={"ModeSelectionGui","ShopGui","InventoryGui","SettingsGui","QuestGui"};local function open(name:string)local selected:GuiObject?=nil;for _,n in large do local x=player.PlayerGui:FindFirstChild(n);if x and x:IsA("ScreenGui")then x.Enabled=n==name;if n==name then selected=x:FindFirstChildWhichIsA("GuiButton",true)end end end;GuiService.SelectedObject=selected end
local function button(text:string,x:number,width:number):TextButton local b=Instance.new("TextButton");b.Position=UDim2.fromScale(x,.86);b.Size=UDim2.fromScale(width,.07);b.Text=text;b.TextScaled=true;b.Selectable=true;b.Parent=gui;return b end
local modes=button("模式",.03,.11);local shop=button("商店",.15,.08);local inventory=button("背包",.24,.08);local settings=button("設定",.33,.08);local tutorial=button("新手教學",.42,.11)
modes.Activated:Connect(function()open("ModeSelectionGui")end);shop.Activated:Connect(function()open("ShopGui")end);inventory.Activated:Connect(function()open("InventoryGui")end);settings.Activated:Connect(function()open("SettingsGui")end);tutorial.Activated:Connect(function()local remote=ReplicatedStorage.Remotes:FindFirstChild("RestartTutorial");if remote and remote:IsA("RemoteEvent")then remote:FireServer()end end)
local state=ReplicatedStorage:WaitForChild("Remotes",10) and ReplicatedStorage.Remotes:WaitForChild("ModeStateChanged",10);if state and state:IsA("RemoteEvent")then state.OnClientEvent:Connect(function(d)local visible=d.inLobby==true;for _,b in {modes,shop,inventory,settings,tutorial}do b.Visible=visible end;if not visible then for _,n in large do local x=player.PlayerGui:FindFirstChild(n);if x and x:IsA("ScreenGui")then x.Enabled=false end end;GuiService.SelectedObject=nil end end)end
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="108">
        <Properties>
          <string name="Name">MapIntroUI</string>
          <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players");local r=game:GetService("ReplicatedStorage"):WaitForChild("Remotes",10);if not r then return end;local remote=r:WaitForChild("MapIntro")::RemoteEvent;local gui=Instance.new("ScreenGui");gui.Name="MapIntroGui";gui.ResetOnSpawn=false;gui.Parent=Players.LocalPlayer.PlayerGui;local text=Instance.new("TextLabel");text.Position=UDim2.fromScale(.2,.3);text.Size=UDim2.fromScale(.6,.25);text.BackgroundColor3=Color3.fromRGB(20,28,45);text.BackgroundTransparency=.15;text.TextColor3=Color3.new(1,1,1);text.TextScaled=true;text.Visible=false;text.Parent=gui;remote.OnClientEvent:Connect(function(d)text.Text=string.format("%s\n難度 %s・%d Checkpoints\n道具 %s・解謎 %s",d.DisplayName,d.Difficulty,d.CheckpointCount,d.SupportsItems and"有"or"無",d.HasPuzzles and"有"or"無");text.Visible=true;task.delay(2,function()text.Visible=false end)end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="109">
        <Properties>
          <string name="Name">MapVoteUI</string>
          <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players");local ReplicatedStorage=game:GetService("ReplicatedStorage");local player=Players.LocalPlayer;local r=ReplicatedStorage:WaitForChild("Remotes",10);if not r then return end;local started=r:WaitForChild("MapVoteStarted")::RemoteEvent;local submit=r:WaitForChild("SubmitMapVote")::RemoteEvent;local update=r:WaitForChild("MapVoteUpdated")::RemoteEvent;local selected=r:WaitForChild("MapSelected")::RemoteEvent;local gui=Instance.new("ScreenGui");gui.Name="MapVoteGui";gui.ResetOnSpawn=false;gui.Enabled=false;gui.Parent=player.PlayerGui;local frame=Instance.new("Frame");frame.Position=UDim2.fromScale(.15,.2);frame.Size=UDim2.fromScale(.7,.5);frame.BackgroundColor3=Color3.fromRGB(25,35,55);frame.Parent=gui;local buttons:{[string]:TextButton}={};started.OnClientEvent:Connect(function(d)gui.Enabled=true;for _,x in frame:GetChildren()do x:Destroy()end;table.clear(buttons);for i,m in d.candidates do local b=Instance.new("TextButton");b.Position=UDim2.fromScale(.04+(i-1)*.32,.12);b.Size=UDim2.fromScale(.29,.7);b.Text=string.format("%s\n%s\n難度 %s\n道具 %s\n解謎 %s",m.DisplayName,m.Description,m.Difficulty,m.SupportsItems and "有"or"無",m.HasPuzzles and"有"or"無");b.TextWrapped=true;b.TextScaled=true;b.Parent=frame;b.Activated:Connect(function()submit:FireServer(m.Id)end);buttons[m.Id]=b end end);update.OnClientEvent:Connect(function(d)for id,b in buttons do b.BackgroundColor3=id==d.selected and Color3.fromRGB(70,190,110)or Color3.fromRGB(70,90,125);b.Text=b.Text:gsub("\n票數 %d+$","").."\n票數 "..tostring(d.counts[id]or 0)end end);selected.OnClientEvent:Connect(function()gui.Enabled=false end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="110">
        <Properties>
          <string name="Name">ModeSelectionUI</string>
          <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players");local ReplicatedStorage=game:GetService("ReplicatedStorage");local player=Players.LocalPlayer;local modes=require(ReplicatedStorage.Modules.ModeConfig);local folder=ReplicatedStorage:WaitForChild("Remotes",10);if not folder then return end;local selectRemote=folder:WaitForChild("SelectMode")::RemoteEvent;local open=folder:WaitForChild("OpenMenu")::RemoteEvent
local gui=Instance.new("ScreenGui");gui.Name="ModeSelectionGui";gui.ResetOnSpawn=false;gui.Enabled=false;gui.Parent=player.PlayerGui;local frame=Instance.new("Frame");frame.Position=UDim2.fromScale(.2,.15);frame.Size=UDim2.fromScale(.6,.68);frame.BackgroundColor3=Color3.fromRGB(25,32,48);frame.BackgroundTransparency=.08;frame.Parent=gui;Instance.new("UICorner",frame).CornerRadius=UDim.new(.04,0)
local title=Instance.new("TextLabel");title.Size=UDim2.fromScale(1,.12);title.BackgroundTransparency=1;title.Text="爆笑村莊廣場・選擇模式";title.TextScaled=true;title.TextColor3=Color3.new(1,1,1);title.Font=Enum.Font.GothamBold;title.Parent=frame
local pending:string?=nil;local confirm=Instance.new("TextLabel");confirm.Position=UDim2.fromScale(.08,.72);confirm.Size=UDim2.fromScale(.84,.1);confirm.BackgroundTransparency=1;confirm.Text="";confirm.TextScaled=true;confirm.TextColor3=Color3.fromRGB(255,225,90);confirm.Parent=frame
local join=Instance.new("TextButton");join.Position=UDim2.fromScale(.2,.84);join.Size=UDim2.fromScale(.25,.1);join.Text="加入";join.TextScaled=true;join.BackgroundColor3=Color3.fromRGB(70,195,110);join.Parent=frame
local cancel=Instance.new("TextButton");cancel.Position=UDim2.fromScale(.55,.84);cancel.Size=UDim2.fromScale(.25,.1);cancel.Text="取消";cancel.TextScaled=true;cancel.BackgroundColor3=Color3.fromRGB(190,80,80);cancel.Parent=frame
local ids={"CasualRace","RankedRace","SoloTower","SoloTower02"};for i,id in ids do local m=modes[id];local col=(i-1)%2;local row=math.floor((i-1)/2);local b=Instance.new("TextButton");b.Position=UDim2.fromScale(.07+col*.47,.15+row*.27);b.Size=UDim2.fromScale(.4,.23);b.Text=string.format("%s\n%s\n%d～%d 人・%s",m.DisplayName,m.Description,m.MinimumPlayers,m.MaximumPlayers,m.IsRanked and "影響牌位" or "不影響牌位");b.TextWrapped=true;b.TextScaled=true;b.BackgroundColor3=m.IsRanked and Color3.fromRGB(180,130,45) or Color3.fromRGB(55,115,165);b.TextColor3=Color3.new(1,1,1);b.Parent=frame;b.Selectable=true;b.Activated:Connect(function()pending=id;confirm.Text="是否加入「"..m.DisplayName.."」？"end)end
join.Activated:Connect(function() if pending then selectRemote:FireServer(pending);gui.Enabled=false;pending=nil end end);cancel.Activated:Connect(function()pending=nil;confirm.Text="";gui.Enabled=false end)
open.OnClientEvent:Connect(function(data)gui.Enabled=true;if data.confirmMode and modes[data.confirmMode] then pending=data.confirmMode;confirm.Text="是否加入「"..modes[pending].DisplayName.."」？" end end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="111">
