          <string name="Name">AchievementUI</string>
          <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players");local r=game:GetService("ReplicatedStorage"):WaitForChild("Remotes",10);if not r then return end;local remote=r:WaitForChild("AchievementUnlocked")::RemoteEvent;local gui=Instance.new("ScreenGui");gui.Name="AchievementGui";gui.ResetOnSpawn=false;gui.Parent=Players.LocalPlayer.PlayerGui;local t=Instance.new("TextLabel");t.Position=UDim2.fromScale(.3,.1);t.Size=UDim2.fromScale(.4,.1);t.BackgroundColor3=Color3.fromRGB(190,135,35);t.TextColor3=Color3.new(1,1,1);t.TextScaled=true;t.Visible=false;t.Parent=gui;remote.OnClientEvent:Connect(function(d)t.Text="成就解鎖："..d.name.."　+"..d.reward.." Coins";t.Visible=true;task.delay(3,function()t.Visible=false end)end)
