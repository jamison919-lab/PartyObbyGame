local Players=game:GetService("Players");local Profiles=require(script.Parent.Services.PlayerProfileService);local Events=require(script.Parent.Services.GameplayEventService);local Quest=require(script.Parent.Services.QuestService);local remotes=require(script.Parent.Services.RemoteService).Ensure();Events.Event.Event:Connect(function(p,event,amount)local ok,err=pcall(Quest.Progress,p,event,amount);if not ok then warn("[Quest] update failed: "..tostring(err))end end);remotes.ClaimQuest.OnServerEvent:Connect(function(p,id)if typeof(id)=="string"then local ok,msg=Quest.Claim(p,id);remotes.PurchaseResult:FireClient(p,{success=ok,message=msg})end end);local function ready(p:Player)task.spawn(function()local deadline=os.clock()+20;while not Profiles.IsProfileLoaded(p)and os.clock()<deadline do task.wait(.2)end;local snapshot=Quest.Snapshot(p);if snapshot then remotes.QuestUpdated:FireClient(p,snapshot)end end)end;Players.PlayerAdded:Connect(ready);for _,p in Players:GetPlayers()do ready(p)end
]]></string>
