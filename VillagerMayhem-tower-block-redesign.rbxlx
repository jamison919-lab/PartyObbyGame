      <Item class="LocalScript" referent="103">
        <Properties>
          <string name="Name">InventoryUI</string>
          <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players");local ReplicatedStorage=game:GetService("ReplicatedStorage");local player=Players.LocalPlayer;local remotes=ReplicatedStorage:WaitForChild("Remotes",10);if not remotes then return end;local updated=remotes:WaitForChild("ProfileUpdated")::RemoteEvent;local unequip=remotes:WaitForChild("UnequipCosmetic")::RemoteEvent
local gui=Instance.new("ScreenGui");gui.Name="InventoryGui";gui.ResetOnSpawn=false;gui.Enabled=false;gui.Parent=player.PlayerGui;local frame=Instance.new("Frame");frame.Position=UDim2.fromScale(.25,.2);frame.Size=UDim2.fromScale(.5,.55);frame.BackgroundColor3=Color3.fromRGB(32,38,58);frame.Parent=gui;local label=Instance.new("TextLabel");label.Size=UDim2.fromScale(1,.72);label.BackgroundTransparency=1;label.TextColor3=Color3.new(1,1,1);label.TextScaled=true;label.TextWrapped=true;label.Parent=frame;local clear=Instance.new("TextButton");clear.Position=UDim2.fromScale(.15,.78);clear.Size=UDim2.fromScale(.7,.12);clear.Text="卸下所有外觀";clear.TextScaled=true;clear.Parent=frame;clear.Activated:Connect(function()for _,slot in {"Outfit","HeadAccessory","BackAccessory","Trail","FinishEffect","ItemSkin","Emote","Title"}do unequip:FireServer(slot)end end)
updated.OnClientEvent:Connect(function(d)label.Text="已擁有：\n"..table.concat(d.ownedCosmeticIds or {},"、").."\n\n消耗品：\nChili "..tostring((d.consumableCounts or {}).CasualChiliTicket or 0).."　Shield "..tostring((d.consumableCounts or {}).CasualShieldTicket or 0).."　Revive "..tostring((d.consumableCounts or {}).TowerReviveTicket or 0)end)
]]></string>
