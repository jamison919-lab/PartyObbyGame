remotes.UpdateSettings.OnServerEvent:Connect(function(player,key,value)if typeof(key)~="string"or allowed[key]~=typeof(value)or os.clock()-(rate[player]or 0)<.15 then return end;if key=="UIScale"and not table.find({"Small","Normal","Large"},value)then return end;rate[player]=os.clock();if Profiles.UpdateValue(player,"Settings."..key,value)then send(player)end end)
