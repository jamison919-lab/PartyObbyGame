          <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players");local ReplicatedStorage=game:GetService("ReplicatedStorage");local player=Players.LocalPlayer;local remotes=ReplicatedStorage:WaitForChild("Remotes",10);if not remotes then return end;local updated=remotes:WaitForChild("ProfileUpdated")::RemoteEvent;local request=remotes:WaitForChild("RequestProfile")::RemoteEvent;local claim=remotes:WaitForChild("ClaimDailyReward")::RemoteEvent
local gui=Instance.new("ScreenGui");gui.Name="ProfileGui";gui.ResetOnSpawn=false;gui.Parent=player.PlayerGui;local bar=Instance.new("TextLabel");bar.Position=UDim2.fromScale(.3,.02);bar.Size=UDim2.fromScale(.4,.06);bar.BackgroundColor3=Color3.fromRGB(38,45,65);bar.BackgroundTransparency=.12;bar.TextColor3=Color3.new(1,1,1);bar.TextScaled=true;bar.Text="載入資料中…";bar.Parent=gui;local daily=Instance.new("TextButton");daily.Position=UDim2.fromScale(.82,.14);daily.Size=UDim2.fromScale(.15,.06);daily.Text="每日獎勵";daily.TextScaled=true;daily.Parent=gui
updated.OnClientEvent:Connect(function(d)if d.loadFailed then bar.Text=d.message;return end;bar.Text=string.format("Coins %d　RP %d　Wins %d%s",d.coins or 0,d.rankPoints or 0,d.wins or 0,d.memoryMode and "　[測試資料・關閉測試後不會保存]" or "");gui:SetAttribute("SnapshotReceived",true)end);daily.Activated:Connect(function()claim:FireServer()end);request:FireServer()
]]></string>
